<#@ template debug="false" hostspecific="false" linePragmas="false" language="C#" #>
<#@ import namespace="Bindings.GeneratorCore" #>
#nullable enable
<# if (HasNamespace) { #>
namespace <#= Context.Namespace #>
{
<# } #>
<# foreach (var (accessibility, typeKeyword, typeName) in Context.ContainingTypes) {#>
<#= accessibility #> partial <#= typeKeyword #> <#= typeName #>
{
<# } #>
<# if (!Context.AlreadySerializable) { #>
#if UNITY_EDITOR
[global::System.Serializable]
#endif
<# } #>
<#= Context.Accessibility #> partial <#= TypeKeyword #> <#= Context.ClassName #> : global::Bindings.IViewModel
{
    private readonly global::Bindings.IMvvmPublisher _publisher;
<# foreach (var schemaField in SchemaPropertyFields) {#>

    public <#= schemaField.FieldTypeName #> <#= ToPropertyName(schemaField.FieldName) #>
    {
        get => <#= schemaField.FieldName #>;
<# if (!Context.IsReadOnly) { #>
        set
        {
            <#= schemaField.FieldName #> = value;
            PublishRebindMessage();
        }
<# } #>
    }
<# } #>

    public <#= Context.ClassName #>(<#= ConstructorParamList #>)
    {
<# foreach (var field in Context.RequiredFields) { #>
        <#= field.FieldName #> = <#= ToParamName(field.FieldName) #>;
<# } #>
        _publisher = publisher;
<# if (!Context.IsStruct) { #>
        OnPostConstruct();
<# } #>
    }

    public void NotifyCompletedBind() => OnPostBind();

    partial void OnPostBind();
<# if (!Context.IsStruct) { #>

    partial void OnPostConstruct();
<# } #>

    [global::System.Runtime.CompilerServices.MethodImpl(global::System.Runtime.CompilerServices.MethodImplOptions.AggressiveInlining)]
    private void PublishRebindMessage()
    {
        _publisher.PublishRebindMessage<<#= ViewModelFullName #>>();
    }
<#if (Context.GenerateVContainerInjector) {#>

    [global::VContainer.Preserve]
    private sealed class __BindingsInjector : global::VContainer.IInjector
    {
        public object CreateInstance(global::VContainer.IObjectResolver resolver, global::System.Collections.Generic.IReadOnlyList<global::VContainer.IInjectParameter> parameters)
        {
            return new <#= ViewModelFullName #>(
<#foreach (var field in Context.RequiredFields) {#>
                (<#= field.TypeFullName #>)global::VContainer.IObjectResolverExtensions.ResolveOrParameter(resolver, typeof(<#= field.TypeOfName #>), "<#= ToParamName(field.FieldName) #>", parameters),
<#}#>
                (global::Bindings.IMvvmPublisher)global::VContainer.IObjectResolverExtensions.ResolveOrParameter(resolver, typeof(global::Bindings.IMvvmPublisher), "publisher", parameters));
        }

        public void Inject(object instance, global::VContainer.IObjectResolver resolver, global::System.Collections.Generic.IReadOnlyList<global::VContainer.IInjectParameter> parameters)
        {
            // All dependencies are supplied through the generated constructor.
        }
    }
<#}#>
}
<# foreach (var _ in Context.ContainingTypes) { #>
}
<# } #>
<# if (HasNamespace) { #>
}
<# } #>
